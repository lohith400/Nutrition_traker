# ---- AI coach: fill ONE key below and leave the other two blank ----
# Get a key from: openrouter.ai  |  aistudio.google.com/apikey  |  platform.deepseek.com
OPENROUTER_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Optional: model override (blank = default: openai/gpt-4o-mini, deepseek-chat; Gemini auto-picks the newest available model)
OPENROUTER_MODEL=
GEMINI_MODEL=
DEEPSEEK_MODEL=
# Optional: only if you fill more than one key and want to choose (openrouter | gemini | deepseek)
# LLM_PROVIDER=
CORS_ORIGINS=http://localhost:3000
# Optional: enables "find restaurants near me" in the coach chat (Google Places API (New))
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# ---- Reminder notifications (all optional, all free) ----
# Phone push via ntfy.sh: install the "ntfy" app, subscribe to this exact topic.
# Use a long random topic -- anyone who knows the name can read it.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# Email via SMTP. For Gmail: turn on 2-step verification, then create an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER if empty
NOTIFY_EMAIL_TO=
# Reminders use the server clock. Set this on Docker/cloud so 2 PM means 2 PM in India.
# Linux/Docker/Render only. Do NOT set on Windows; Windows already uses your system clock.
# TZ=Asia/Kolkata
# Skip a reminder that is this many minutes late (server was off)
# REMINDER_GRACE_MINUTES=15

# ---- Production / free cloud deployment (leave blank on localhost) ----
# Turso = free cloud SQLite so your data survives restarts of the free host. Blank = local nutrisync.db file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Password for the app. When set, the API only answers requests that send it (the phone app asks once).
ACCESS_KEY=
# In production set the line CORS_ORIGINS above to your deployed frontend (exact URL, no trailing slash),
# e.g. CORS_ORIGINS=https://nutrisync.vercel.app,http://localhost:3000
# Optional: also allow all Vercel preview URLs
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
# How many previous chat turns the coach receives on every message (default 20)
# CHAT_CONTEXT_MESSAGES=20
