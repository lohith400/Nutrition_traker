# ==============================================================================
# AI Coach LLM Configuration
# ==============================================================================
# Primary Provider: Google AI Studio (Gemini)
# Get a free key at: https://aistudio.google.com/apikey
# When GEMINI_API_KEY is provided, Gemini is preferred with a zero-crash,
# multi-model fallback cascade:
#   1. gemini-2.5-flash
#   2. gemini-2.5-flash-lite
#   3. gemini-2.0-flash
#   4. gemini-1.5-flash
#   5. gemini-1.5-flash-8b
# If all hardcoded cascade models fail (e.g. 404, 429 quota exhaustion, or 503 overload),
# dynamic discovery queries client.models.list() for active Flash models.
# If all Gemini models fail or no Gemini key is set, automatically falls back to OpenRouter.
GEMINI_API_KEY=

# Fallback / Secondary Provider: OpenRouter
# Get a key at: https://openrouter.ai
# Used as secondary fallback when Gemini fails, or primary when GEMINI_API_KEY is unset.
# Default model: openrouter/free
OPENROUTER_API_KEY=

# Alternative Provider: DeepSeek
# Get a key at: https://platform.deepseek.com
# Default model: deepseek-chat
DEEPSEEK_API_KEY=

# Optional model overrides (leave blank for automatic cascade and smart defaults):
# - GEMINI_MODEL: blank = automatic 5-model cascade (gemini-2.5-flash -> ... -> gemini-1.5-flash-8b)
# - OPENROUTER_MODEL: blank = openrouter/free
# - DEEPSEEK_MODEL: blank = deepseek-chat
# - LLM_MODEL: global override for whichever provider is active
GEMINI_MODEL=
OPENROUTER_MODEL=
DEEPSEEK_MODEL=

# Optional: Force a specific provider (gemini | openrouter | deepseek)
# If blank, defaults to: gemini (if GEMINI_API_KEY is set) -> openrouter -> deepseek
# LLM_PROVIDER=

CORS_ORIGINS=http://localhost:3000
# Optional: enables "find restaurants near me" in the coach chat (Google Places API (New))
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# ---- Reminder notifications (all optional, all free) ----
# Phone push via ntfy.sh: install the "ntfy" app, subscribe to this exact topic.
# Use a long random topic -- anyone who knows the name can read it.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# Email via SMTP. For Gmail: turn on 2-step verification, then create an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER if empty
NOTIFY_EMAIL_TO=
# Reminders use the server clock. Set this on Docker/cloud so 2 PM means 2 PM in India.
# Linux/Docker/Render only. Do NOT set on Windows; Windows already uses your system clock.
# TZ=Asia/Kolkata
# Skip a reminder that is this many minutes late (server was off)
# REMINDER_GRACE_MINUTES=15

# ---- Production / free cloud deployment (leave blank on localhost) ----
# Turso = free cloud SQLite so your data survives restarts of the free host. Blank = local nutrisync.db file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Password for the app. When set, the API only answers requests that send it (the phone app asks once).
ACCESS_KEY=
# In production set the line CORS_ORIGINS above to your deployed frontend (exact URL, no trailing slash),
# e.g. CORS_ORIGINS=https://nutrisync.vercel.app,http://localhost:3000
# Optional: also allow all Vercel preview URLs
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
# How many previous chat turns the coach receives on every message (default 20)
# CHAT_CONTEXT_MESSAGES=20
