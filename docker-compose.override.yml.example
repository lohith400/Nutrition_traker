# Example Docker Compose override for active local development with hot reload.
# To use:
#   Copy this file to docker-compose.override.yml:
#     cp docker-compose.override.yml.example docker-compose.override.yml
#   Then run:
#     docker compose up --build

services:
  backend:
    volumes:
      - ./backend:/app/backend
      - ./data:/app/data
      - ./db_setup.py:/app/db_setup.py
      - ./math_engine.py:/app/math_engine.py
      - ./memory_agent.py:/app/memory_agent.py
      - ./menu_planner.py:/app/menu_planner.py
      - ./orchestrator.py:/app/orchestrator.py
      - ./rag_resolver.py:/app/rag_resolver.py
    command: ["python", "-m", "uvicorn", "backend.app:app", "--reload", "--host", "0.0.0.0", "--port", "8000"]

  frontend:
    volumes:
      - ./frontend/app:/app/app
      - ./frontend/public:/app/public
    command: ["npm", "run", "dev"]
