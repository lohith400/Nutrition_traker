# ==============================================================================
# NutriSync Environment Variables Configuration Template
# Copy this file to .env (or backend/.env and frontend/.env.local)
# No real secret values are stored in this template.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Coach LLM Configuration
# ------------------------------------------------------------------------------
# Primary Provider: Google AI Studio (Gemini)
# Automatic fallback cascade: gemini-2.5-flash -> gemini-2.5-flash-lite -> gemini-2.0-flash -> gemini-1.5-flash -> gemini-1.5-flash-8b
GEMINI_API_KEY=

# Secondary Provider: OpenRouter (used when Gemini fails or is unset)
OPENROUTER_API_KEY=

# Alternative Provider: DeepSeek
DEEPSEEK_API_KEY=

# Optional Model Overrides (leave blank for automatic cascade and smart defaults)
GEMINI_MODEL=
OPENROUTER_MODEL=
DEEPSEEK_MODEL=
LLM_MODEL=

# Optional: Force a specific provider ('gemini' | 'openrouter' | 'deepseek')
LLM_PROVIDER=

# ------------------------------------------------------------------------------
# 2. Server, CORS & Network Settings
# ------------------------------------------------------------------------------
# Backend port (default: 8000)
PORT=8000

# Allowed CORS origins (comma-separated, no trailing slashes)
CORS_ORIGINS=http://localhost:3000

# Optional Regex pattern to allow preview domains (e.g., https://.*\.vercel\.app)
CORS_ORIGIN_REGEX=

# Optional: Google Maps Places API key for restaurant discovery in chat
GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# 3. Native Web Push & Email Notifications (Reminders)
# ------------------------------------------------------------------------------
# Web Push VAPID keys (generate with: python scripts/generate_vapid_keys.py)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:you@example.com

# SMTP settings for email reminder channel
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=

# Server timezone for scheduled reminders (e.g. Asia/Kolkata for Linux/Docker)
TZ=Asia/Kolkata

# Max delay in minutes to still fire overdue reminders after server downtime
REMINDER_GRACE_MINUTES=15

# ------------------------------------------------------------------------------
# 4. Database & Production Security
# ------------------------------------------------------------------------------
# Path to local SQLite DB (leave empty to use default nutrisync.db)
NUTRISYNC_DB_PATH=

# Turso Cloud SQLite (libsql) credentials (leave empty to use local SQLite)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# App access gate key (when set, the API rejects unauthorized requests with 401)
ACCESS_KEY=

# Number of historical chat turns provided to the agent (default: 20)
CHAT_CONTEXT_MESSAGES=20

# ------------------------------------------------------------------------------
# 5. Frontend Configuration
# ------------------------------------------------------------------------------
# Public API URL reached from the browser client (inlined at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
